# 이 파일을 복사해서 .env 로 이름을 바꾸고 실제 키를 채워넣으세요.
# .env는 절대 git에 커밋하지 마세요 (.gitignore에 이미 포함되어 있음)

# Google Cloud Vision API 키
# 발급: https://console.cloud.google.com/apis/credentials
GOOGLE_VISION_API_KEY=여기에_구글_비전_API_키

# Papago 번역 API (네이버 클라우드 플랫폼)
# 발급: https://www.ncloud.com/product/aiService/papagoNmt
PAPAGO_CLIENT_ID=여기에_파파고_클라이언트_ID
PAPAGO_CLIENT_SECRET=여기에_파파고_클라이언트_시크릿
